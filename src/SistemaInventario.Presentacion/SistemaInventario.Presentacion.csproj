<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- La capa de Presentación NO puede ver Acceso a Datos: se desactivan las referencias transitivas -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SistemaInventario.Entidades\SistemaInventario.Entidades.csproj" />
    <ProjectReference Include="..\SistemaInventario.LogicaNegocio\SistemaInventario.LogicaNegocio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="conexion.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
